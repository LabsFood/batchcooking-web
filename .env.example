# Authentication

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/espace-client
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/espace-client

# Database (add your DB provider URL here)
DATABASE_URL=

# Email (for notifications)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=contact@labsfood.fr

# Stripe (payment)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OpenAI (for AI shopping list generation)
OPENAI_API_KEY=

# Backend API Lab’s Food — source de vérité du rôle et des données.
#
# Le navigateur appelle l'API en direct : il faut l'URL complète. Le relais
# same-origin /lf-api (et API_PROXY_TARGET) a été retiré le 20/11 — il bloquait
# en prod, et le CORS de l'API autorise GET, HEAD, POST, PUT, PATCH et DELETE
# depuis le 03/10. Une URL relative arrête le build.
#
# `develop` est la branche de référence. En prod : https://lf-api.labsfood.fr.
NEXT_PUBLIC_API_URL=https://lf-api-develop.up.railway.app

# Next public variables (accessible in browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# Observabilité — vides = éteints. Les NEXT_PUBLIC_* sont figées au build (Dockerfile).
# Sentry (région UE), projet batchcooking-web : erreurs JS et rendus cassés.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ENVIRONMENT=development
# Build seulement : envoi des source maps. Sans jeton, le build passe sans elles.
SENTRY_ORG=
SENTRY_AUTH_TOKEN=
# Build et exécution : garde les identifiants des Server Actions d'un déploiement à
# l'autre (connexion Clerk). Une par environnement : openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# PostHog (EU Cloud) : mesure d'audience, seulement après consentement (lib/analytics.ts).
NEXT_PUBLIC_POSTHOG_KEY=

# Stripe : clé publique (pk_test_… / pk_live_…), pour le jeton de compte du batch cooker.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
