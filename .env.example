# Authentication

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/espace-client
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/espace-client

# Database (add your DB provider URL here)
DATABASE_URL=

# Email (for notifications)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=contact@labsfood.fr

# Stripe (payment)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OpenAI (for AI shopping list generation)
OPENAI_API_KEY=

# Backend API Labs Food — source de vérité du rôle et des données.
#
# Le navigateur appelle /lf-api/*, et Next relaie vers API_PROXY_TARGET côté
# serveur. Ce n'est plus une béquille anti-CORS — l'API autorise GET, HEAD,
# POST, PUT, PATCH et DELETE depuis le 04/10 — mais ça évite d'exposer l'URL
# de l'API au navigateur.
#
# `develop` est la branche de référence : elle porte tout depuis le merge du
# 06/10. À remettre sur https://lf-api.labsfood.fr après la recette.
#
# Pour appeler l'API en direct, sans proxy :
#   NEXT_PUBLIC_API_URL=https://lf-api-develop.up.railway.app
NEXT_PUBLIC_API_URL=/lf-api
API_PROXY_TARGET=https://lf-api-develop.up.railway.app

# Next public variables (accessible in browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# Observabilité — vides = éteints. Les NEXT_PUBLIC_* sont figées au build (Dockerfile).
# Sentry (région UE), projet batchcooking-web : erreurs JS et rendus cassés.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ENVIRONMENT=development
# Build seulement : envoi des source maps. Sans jeton, le build passe sans elles.
SENTRY_ORG=
SENTRY_AUTH_TOKEN=
# PostHog (EU Cloud) : mesure d'audience, seulement après consentement (lib/analytics.ts).
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com
